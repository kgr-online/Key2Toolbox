    <!-- Calculator Keys -->
    <string name="desc_calculator">In the AOSP/Google Calculator, route physical keys to the calculator buttons: digits (Q W E R / S D F / Z X C for 0-9), plus operators - O = +, I = -, A = ×, G = ÷, M = ., U = %%, B = !, T/Y = ( ), Sym/Alt toggles scientific mode, Backspace deletes. No root needed - uses the accessibility service only.</string>

    <!-- IME Suggestions -->
    <string name="requires_ctrl_remap">Ctrl+W/E/R only work once a key is remapped to Ctrl - these shortcuts do nothing on their own otherwise.</string>
    <string name="action_open_key_remap">Open Remap Key → Ctrl</string>
    <string name="desc_ime_suggestions">Press Ctrl+W, Ctrl+E, or Ctrl+R to pick suggestion 1, 2, or 3 from the physical keyboard\'s candidate strip (BlackBerry Keyboard and similar). Only acts when a suggestion is actually showing, so Ctrl+W/E/R still behave normally elsewhere (e.g. closing a browser tab). Requires a key remapped to Ctrl (see Remap Key → Ctrl). No root required.</string>

    <!-- Call Shortcuts -->
    <string name="requires_auto_focus_dialer">Mute and speaker work standalone. For fast, reliable dial-pad digit entry (speed dial), also enable Auto-Focus for the Phone/Dialer app.</string>
    <string name="action_open_auto_focus">Open Auto-Focus</string>
    <string name="desc_in_call_shortcuts">On the Google Phone call screen, use M to mute/unmute, the Currency key (or Ctrl, if remapped) to toggle the speaker, and Q W E R / S D F / Z X C to open the dialer keypad and dial digits. No root required.</string>

    <!-- Auto-Focus -->
    <string name="desc_auto_focus">In the selected apps, the first text field found is focused and typed into as soon as you press a printable key with nothing already focused - handy for search/entry fields that otherwise need a tap first. No root required.</string>
    <string name="enable_auto_focus">Enable auto-focus</string>

    <!-- Per-App Keyboard Block -->
    <string name="desc_ime_block">In the selected apps, physical key presses go straight to the app instead of through the keyboard - handy for games where the BlackBerry keyboard otherwise intercepts the keys. While a selected app is open, the input method is switched to a do-nothing passthrough keyboard, then restored on the way out. Needs root.</string>
    <string name="enable_ime_block">Enable per-app block</string>

    <!-- Key Remap -->
    <string name="key_remap_source_title">Remap to Ctrl</string>
    <string name="key_remap_currency_label">Currency key</string>
    <string name="key_remap_currency_desc">The $ / € key next to Space. Remapping it to Ctrl doesn\'t affect normal typing.</string>
    <string name="key_remap_convenience_label">Convenience key</string>
    <string name="key_remap_convenience_desc">The dedicated side button. Remapping it to Ctrl means it no longer launches its assigned shortcut.</string>
    <string name="desc_key_remap">Remaps the selected key to Ctrl at the keylayout level, so it works as a real modifier for the Calculator Keys and IME Suggestions shortcuts. Persists across reboots via a service.d boot script.</string>

    <!-- Adaptive Keyboard Backlight -->
    <string name="status_kbd_light_enabled">Keyboard backlight enabled. Persisted: %1$s.</string>
    <string name="status_kbd_light_disabled">Keyboard backlight disabled. Persisted: %1$s.</string>

    <!-- Lockscreen PIN on Keyboard -->
    <string name="desc_pin_keyboard">Type your lockscreen PIN on the physical keyboard. Digits map phone-dialpad style: W E R = 1 2 3, S D F = 4 5 6, Z X C = 7 8 9, Q = 0. Enter confirms, Backspace deletes. No root needed - uses the accessibility service only.</string>

    <!-- Keyboard Nav Lock -->
    <string name="nav_lock_intro">Stops accidental Back / Home / Recents presses while the keyboard is showing. Pick a mode below.</string>
    <string name="nav_lock_toggle">Keyboard Nav Lock</string>
    <string name="nav_lock_gesture_desc">Double-tap Back (keep button): while typing, a single tap on Back is ignored - only a double-tap fires it. Only Back works this way; Android won\'t let an app gate Home/Recents. Off = all three buttons are fully disabled while typing (needs root).</string>
    <string name="nav_lock_gesture_toggle">Double-tap Back</string>
    <string name="nav_lock_always_off_desc">Disable nav buttons ALWAYS: keeps Back / Home / Recents disabled permanently, not just while typing. Navigate with gestures instead. Overrides the modes above; turn off to restore the buttons. Needs root.</string>
    <string name="nav_lock_always_off_toggle">Disable ALWAYS</string>

