    <!-- BBProdFix Settings -->
    <string name="k2pf_checking">Checking for bb-prodfix module…</string>
    <string name="k2pf_not_installed">The bb-prodfix (BBProdFix) module is not installed.</string>
    <string name="k2pf_install_instructions">Install the BBProdFix Magisk/APatch module to access these settings. Once installed, return here to manage its tweaks.</string>
    <string name="k2pf_intro">Manage BBProdFix module settings here. Changes to system props require a reboot to take effect.</string>
    <string name="k2pf_identity_title">BlackBerry Device Identity</string>
    <string name="k2pf_identity_desc">Forces ro.product.* props to BlackBerry values (brand=blackberry, model=KEY2, manufacturer=BlackBerry). Required by some BB-specific apps to verify they\'re running on a Key2. Your ROM may already set these correctly.</string>
    <string name="k2pf_a2dp_title">Bluetooth A2DP Offload</string>
    <string name="k2pf_a2dp_desc">Moves Bluetooth audio processing to the DSP. Improves audio quality and battery life on BT headphones. Persist props apply live; audio stack restart may be needed.</string>
    <string name="k2pf_volume_steps_title">Extended Volume Steps</string>
    <string name="k2pf_volume_steps_desc">14 call volume steps and 30 media volume steps instead of the Android defaults (7 and 15).</string>
    <string name="k2pf_triple_buffer_title">SurfaceFlinger Triple Buffering</string>
    <string name="k2pf_triple_buffer_desc">Allows SurfaceFlinger to hold 3 frame buffers instead of 2. Can reduce jank under GPU load.</string>
    <string name="k2pf_bg_app_limit_title">Background App Limit (60)</string>
    <string name="k2pf_bg_app_limit_desc">Tells the Qualcomm process manager to allow up to 60 background apps before killing them. Stock Android is much more aggressive.</string>
    <string name="k2pf_reboot_required">Reboot required</string>
    <string name="k2pf_swappiness_owned_by_zram">Key2 Toolbox is managing swappiness via the ZRAM module. BBProdFix swappiness is disabled — configure it in the ZRAM screen.</string>
    <string name="k2pf_swappiness_current">Current value in BBProdFix service.sh: %1$s. Changes apply on next boot.</string>
    <string name="k2pf_swappiness_conservative">60 — Conservative (recommended)</string>
    <string name="k2pf_swappiness_balanced">80 — Balanced</string>
    <string name="k2pf_swappiness_aggressive">100 — Aggressive</string>

