    <!-- Auto-disable Bluetooth -->
    <string name="desc_bt_idle">Turns Bluetooth off after a period with no device connected, so an idle radio can\'t hold the system awake overnight. Connecting earbuds, a watch or a speaker resets the timer.</string>
