    <string name="zram_apply_dialog_title">Apply ZRAM settings now?</string>
    <string name="zram_apply_dialog_desc">Resizing/recompressing ZRAM live briefly disables swap and can cause background apps to be killed under memory pressure. It\'s usually safer to set this and reboot instead.</string>
    <string name="status_zram_applied_live">ZRAM applied live: %1$s, %2$s, swappiness=%3$d.</string>
    <string name="desc_performance">Fine-tune kernel scheduler scaling rates and CPU input boost to save battery. Tuned settings relax the CPU LITTLE cluster scaling and lower the input boost intensity during screen interaction.</string>
