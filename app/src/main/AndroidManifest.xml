<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- List launchable apps for the per-app keyboard-block picker. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <!-- Required by PlayStoreTagger to enumerate all installed packages. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <!-- Required by LedNotifyListenerService to hold a partial wake lock
         while actively blinking, so Doze (screen off + on battery + idle)
         doesn't suspend the CPU between coroutine delay() ticks and turn a
         steady blink into a stuck-on/stuck-off/flicker mess. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Required by ZramBootCompletedReceiver to reapply persisted swappiness
         after the ROM's own init.rc overwrites it late in boot. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.Key2Toolbox"
        android:supportsRtl="true">

        <!-- Xposed / LSPosed module metadata. Enable the module in LSPosed and
             scope it to Trebuchet to get the two-row Grid / Masonry Overview. -->
        <meta-data
            android:name="xposedmodule"
            android:value="true" />
        <meta-data
            android:name="xposeddescription"
            android:value="Two-row grid Recents/Overview for Launcher3 QuickStep" />
        <meta-data
            android:name="xposedminversion"
            android:value="54" />
        <meta-data
            android:name="xposedscope"
            android:resource="@array/xposed_scope" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Key2Toolbox">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".service.Key2PassthroughIme"
            android:label="Key2 Passthrough"
            android:exported="true"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/passthrough_ime" />
        </service>

        <service
            android:name=".service.Key2AccessibilityService"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- LED Notify: watches posted/cleared notifications to drive per-app LED colors. -->
        <service
            android:name=".service.LedNotifyListenerService"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <service
            android:name=".service.TickerNotificationListenerService"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Reapplies persisted ZRAM swappiness after boot fully completes,
             since the ROM's init.rc overwrites it after service.d runs. -->
        <receiver
            android:name=".receiver.ZramBootCompletedReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
